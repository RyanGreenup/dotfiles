#!/usr/bin/env bash
# kitty-keys: fuzzy-find kitty keybindings with rich preview
set -euo pipefail

YAML="${KITTY_KEYS_YAML:-$HOME/.config/kitty/keybindings.yaml}"

# Build detail file: icon+key \t action \t category \t description \t kitty_action
DETAIL_FILE=$(mktemp /tmp/kitty-keys-XXXXXX.txt)
trap 'rm -f "$DETAIL_FILE"' EXIT

# yq @tsv produces real tabs between array elements
yq -r '
  .categories[] |
  .name as $cat | .icon as $icon |
  .bindings[] |
  [($icon + "  " + .key), .action, $cat, (.description | sub("\n";" "; "g")), .kitty_action] | @tsv
' "$YAML" > "$DETAIL_FILE"

# fzf input: first two fields (icon+key, action)
FZF_INPUT=$(cut -f1,2 "$DETAIL_FILE")

# Preview: look up the selected line in the detail file and format a card
PREVIEW_CMD="
  sel=\$(echo {} | cut -f1)
  line=\$(grep -F \"\$sel\" \"$DETAIL_FILE\" | head -1)
  [ -z \"\$line\" ] && exit 0
  key=\$(echo \"\$line\" | cut -f1 | sed 's/^[^ ]* *//')
  act=\$(echo \"\$line\" | cut -f2)
  cat=\$(echo \"\$line\" | cut -f3)
  desc=\$(echo \"\$line\" | cut -f4)
  kitty=\$(echo \"\$line\" | cut -f5)
  printf '\033[1;34m%s\033[0m\n' '───────────────────────────────'
  printf '\033[1;33m Category \033[0m  %s\n' \"\$cat\"
  printf '\033[1;33m Key      \033[0m  %s\n' \"\$key\"
  printf '\033[1;33m Action   \033[0m  %s\n' \"\$act\"
  printf '\033[1;34m%s\033[0m\n' '───────────────────────────────'
  printf '\n%s\n' \"\$desc\" | fold -s -w 50
  printf '\n\033[2mkitty: %s\033[0m\n' \"\$kitty\"
"

echo "$FZF_INPUT" | fzf \
  --ansi \
  --delimiter=$'\t' \
  --with-nth=1,2 \
  --tabstop=22 \
  --preview "$PREVIEW_CMD" \
  --preview-window=right:55%:wrap \
  --header="  Kitty Keybindings  ·  Alt+? to reopen" \
  --prompt="  " \
  --bind='enter:abort,esc:abort' \
  --color='header:italic:dim'
