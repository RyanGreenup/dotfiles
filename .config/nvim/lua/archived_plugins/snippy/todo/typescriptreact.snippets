snippet sctx "Solid context provider with useContext"
	import { createContext, useContext, type ParentProps } from "solid-js";
	import { createStore, type SetStoreFunction } from "solid-js/store";

	interface ${1:MyContext}State {
		${2:value}: ${3:string};
	}

	type $1Value = [$1State, SetStoreFunction<$1State>];

	const default$1: $1State = {
		$2: ${4:""},
	};

	const $1Context = createContext<$1Value>([default$1, () => {}]);

	export function $1Provider(props: ParentProps) {
		const [state, setState] = createStore<$1State>({ ...default$1 });
		return (
			<$1Context.Provider value={[state, setState]}>
				{props.children}
			</$1Context.Provider>
		);
	}

	export function use$1(): $1Value {
		return useContext($1Context);
	}

