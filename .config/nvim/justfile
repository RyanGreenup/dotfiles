# Dotfiles bare repo
dotfiles_dir := env("HOME") / ".local/share/dotfiles"
home_dir := env("HOME")
image := "neovim-python"
no_cache := env("NO_CACHE", "0")

# Use podman to compile all the lsp and treesitter artifacts
# Ideal for testing or systems that don't want makedepends
init:
    podman build -t neovim-python . && podman run -it --rm -v $(pwd):/workspace -v ~/.config/nvim:/root/.config/nvim -v ~/.local/share/nvim:/root/.local/share/nvim neovim-python nvim

# Test the local nvim config in a clean container
podman-run:
    #!/usr/bin/env python3
    import subprocess as sp
    build = ["podman", "build", "-t", "{{image}}"]
    if "{{no_cache}}" == "1":
        build.append("--no-cache")
    sp.run(build + ["."], check=True)
    sp.run([
        "podman", "run", "-it", "--rm",
        "--security-opt", "label=disable",
        "-e", "NVIM_SKIP_MASON=1",
        "-v", ".:/root/.config/nvim",
        "-v", "nvim-test-data:/root/.local/share/nvim",
        "{{image}}", "bash", "-c", "mkdir -p /usr/local/lib/nvim/parser && nvim",
    ], check=True)

# Test the committed dotfiles config in a clean container
# Uses git archive from the bare dotfiles repo so only committed state is tested
podman-run-committed:
    #!/usr/bin/env python3
    import subprocess as sp, tempfile, shutil
    from pathlib import Path

    with tempfile.TemporaryDirectory() as tmpdir:
        # Export the committed nvim config from the dotfiles bare repo
        archive = sp.run(
            ["git", "--git-dir", "{{dotfiles_dir}}", "archive", "HEAD", "--", ".config/nvim"],
            capture_output=True, check=True,
        )
        sp.run(
            ["tar", "-x", "-C", tmpdir, "--strip-components=2"],
            input=archive.stdout, check=True,
        )

        # Build image using local Dockerfile (container infra, not config under test)
        build = ["podman", "build", "-t", "{{image}}", "-f", "Dockerfile"]
        if "{{no_cache}}" == "1":
            build.append("--no-cache")
        sp.run(build + [tmpdir], check=True)
        sp.run([
            "podman", "run", "-it", "--rm",
            "--security-opt", "label=disable",
            "-e", "NVIM_SKIP_MASON=1",
            "-v", f"{tmpdir}:/root/.config/nvim",
            "-v", "nvim-test-data:/root/.local/share/nvim",
            "{{image}}", "bash", "-c", "mkdir -p /usr/local/lib/nvim/parser && nvim",
        ], check=True)

# Format all Lua files with stylua (matching lua/plugins/formatting.lua config)
fmt:
    stylua lua/ LuaSnip/ init.lua

test-citations:
    cd scripts/bun-citations && bun build --compile index.ts --outfile cite && bun --bun test

backup-local:
    mv ~/.local/share/nvim ~/.local/share/nvim_bak

rebuild: backup-local init
